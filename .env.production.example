# Production Environment Configuration
# Copy this file to .env and update the values for production deployment

# Application
APP_NAME="متجر الأطفال"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://yourdomain.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kids_store_production
DB_USERNAME=production_user
DB_PASSWORD=secure_password_here

# Session & Cache (Redis recommended for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_EXPIRE_ON_CLOSE=false

CACHE_STORE=redis
CACHE_PREFIX=kids_store_cache

# Queue (Redis recommended for production)
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_EMAIL=admin@yourdomain.com

# File Storage
FILESYSTEM_DISK=public

# AWS S3 (Optional for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Security Settings
BCRYPT_ROUNDS=12
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com

# Rate Limiting
THROTTLE_API_REQUESTS=60
THROTTLE_API_MINUTES=1

# Backup Configuration
BACKUP_CLOUD_DISK=s3
BACKUP_CLOUD_PATH=backups
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_CLOUD_RETENTION_DAYS=30
BACKUP_MAX_LOCAL_FILES=10
BACKUP_MAX_CLOUD_FILES=50
BACKUP_DB_COMPRESS=true
BACKUP_DB_ENCRYPT=false
BACKUP_NOTIFICATIONS_ENABLED=true
BACKUP_NOTIFICATION_EMAIL=admin@yourdomain.com
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=

# Slack Notifications (Optional)
BACKUP_SLACK_ENABLED=false
BACKUP_SLACK_WEBHOOK=
BACKUP_SLACK_CHANNEL=#backups
BACKUP_SLACK_USERNAME="Backup Bot"

# Payment Gateways
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Integration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Local Payment Gateways (Saudi Arabia)
MADA_MERCHANT_ID=
MADA_SECRET_KEY=
MADA_ENDPOINT=https://api.mada.sa

STC_PAY_MERCHANT_ID=
STC_PAY_SECRET_KEY=
STC_PAY_ENDPOINT=https://api.stcpay.com.sa

# Google Services
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_MAPS_API_KEY=

# Social Media
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=

TWITTER_API_KEY=
TWITTER_API_SECRET=

INSTAGRAM_ACCESS_TOKEN=

# SEO & Analytics
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Performance & Optimization
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=256
OPCACHE_MAX_ACCELERATED_FILES=20000

# Image Optimization
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_QUALITY=85
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080

# CDN Configuration (Optional)
CDN_URL=
CDN_ENABLED=false

# Monitoring & Alerts
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_MAX_AGE_HOURS=25
HEALTH_CHECK_MIN_SIZE_MB=1

# Error Tracking (Optional - Sentry, Bugsnag, etc.)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true
TWO_FACTOR_REQUIRED_FOR_ADMIN=true

# API Configuration
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=1

# Maintenance Mode
MAINTENANCE_DRIVER=file
MAINTENANCE_STORE=

# Broadcasting (Optional - for real-time features)
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Pusher (if using real-time features)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite (for asset compilation)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
